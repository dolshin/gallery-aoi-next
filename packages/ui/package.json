{
  "name": "@dolshin/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/theme-default.css.d.ts",
      "import": "./dist/theme/theme-default.css.js",
      "default": "./dist/theme/theme-default.css.js"
    },
    "./index.css": {
      "default": "./dist/index.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css.js",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:dts": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@dolshin/design-token": "workspace:*",
    "@dolshin/icons": "workspace:*",
    "@dolshin/theme-contract": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "react-textarea-autosize": "^8.5.9"
  },
  "devDependencies": {
    "@aoi/eslint-config": "workspace:*",
    "@aoi/tsconfig": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.17.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.1.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "5.9.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0 ",
    "react-dom": "^19.0.0 "
  }
}
