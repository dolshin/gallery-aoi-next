{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": "./src",
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["react"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
