{
  "button": {
    "color": {
      "primary": {
        "default": {
          "bg": {
            "$type": "color",
            "$value": "{color.accent.primary}"
          },
          "fg": {
            "$type": "color",
            "$value": "{color.text.inverse}"
          },
          "border": {
            "$type": "color",
            "$value": "{color.border.default}"
          }
        },
        "hover": {
          "bg": {
            "$type": "color",
            "$value": "{color.accent.secondary}"
          },
          "border": {
            "$type": "color",
            "$value": "{color.text.primary}"
          },
          "fg": {
            "$type": "color",
            "$value": "{color.text.secondary}"
          }
        },
        "disabled": {
          "bg": {
            "$type": "color",
            "$value": "{color.accent.primary}"
          },
          "fg": {
            "$type": "color",
            "$value": "{color.text.primary}"
          },
          "border": {
            "$type": "color",
            "$value": "{color.border.default}"
          }
        }
      }
    },
    "sizing": {
      "md": {
        "height": {
          "$type": "sizing",
          "$value": "{sizing.60}"
        }
      }
    },
    "spacing": {
      "md": {
        "paddingBlock": {
          "$type": "spacing",
          "$value": "{spacing.stack.md}"
        },
        "paddingInline": {
          "$type": "spacing",
          "$value": "{spacing.72}"
        }
      }
    },
    "text": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.500}",
        "fontSize": "{fontSize.14}",
        "lineHeight": "{lineHeight.normal}",
        "letterSpacing": "{letterSpacing.wider}"
      }
    },
    "content": {
      "gap": {
        "$type": "spacing",
        "$value": "{spacing.8}"
      }
    }
  },
  "input": {
    "text": {
      "$type": "typography",
      "$value": "{typography.inline.md}"
    },
    "sizing": {
      "md": {
        "height": {
          "$type": "sizing",
          "$value": "{sizing.56}"
        }
      }
    },
    "spacing": {
      "md": {
        "paddingInline": {
          "$type": "spacing",
          "$value": "{spacing.stack.md}"
        },
        "paddingBlock": {
          "$type": "spacing",
          "$value": "{spacing.stack.sm}"
        }
      }
    },
    "color": {
      "default": {
        "bg": {
          "$type": "color",
          "$value": "{color.surface.base}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.border.default}"
        },
        "placeholder": {
          "$type": "color",
          "$value": "{color.text.muted}"
        }
      },
      "disabled": {
        "bg": {
          "$type": "color",
          "$value": "{color.surface.base}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.border.default}"
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.border.default}"
        }
      },
      "error": {
        "fg": {
          "$type": "color",
          "$value": "{color.text.primary}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.border.default}"
        }
      }
    }
  }
}